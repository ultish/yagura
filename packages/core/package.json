  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
